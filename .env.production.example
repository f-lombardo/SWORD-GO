# HTTP
SWORD_GO_HTTP_PORT=8088
SWORD_GO_BASE_URL=https://sword-go.example.com
SWORD_GO_SECURE_COOKIES=true

# Authentication
SWORD_GO_ADMIN_EMAIL=admin@example.com
# Production-hardening defaults
SWORD_GO_AUTH_STRICT=true
# Set a bcrypt hash value (preferred in strict mode):
SWORD_GO_ADMIN_PASSWORD_HASH=$2a$12$replace.with.generated.bcrypt.hash.value
# Optional non-strict fallback (leave empty in production):
SWORD_GO_ADMIN_PASSWORD=
SWORD_GO_SESSION_SECRET=change-this-secret-with-32plus-random-chars
SWORD_GO_LOGIN_MAX_ATTEMPTS=5
SWORD_GO_LOGIN_WINDOW_SECONDS=600

# SQLite persistence inside the named docker volume
SWORD_GO_DB_DSN=file:/var/lib/sword-go/sword-go.db?cache=shared&mode=rwc
